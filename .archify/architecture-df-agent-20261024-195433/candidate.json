  "cards": [
    { "dot": "rose", "title": "Safety layers", "items": [
      "dfa-agent SA: read roles + objectCreator on landing only, so nothing can be deleted or overwritten",
      "Policy engine rejects unknown action types, paths outside landing and destructive verbs",
      "Code, config and data fixes are report-only; patches are never applied"
    ] },
    { "dot": "amber", "title": "Auto-retry rules", "items": [
      "Event is FAILED (never REJECTED) and root cause is TRANSIENT_INFRA at confidence ≥ 0.7",
      "Fewer than 2 agent retries for the file in 24 h",
      "Source exists in invalid/ and landing/<file> does not"
    ] },
    { "dot": "cyan", "title": "Runtime", "items": [
      "One LangGraph run per incident, SQLite checkpoints in .state/",
      "A crash leaves the message unacked, so Pub/Sub redelivers it",
      "Signatures decide known errors; llama3.2 explains and fills reports"
    ] }
