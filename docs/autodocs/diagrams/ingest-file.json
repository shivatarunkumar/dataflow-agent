  "cards": [
    {
      "dot": "cyan",
      "title": "One run per generation",
      "items": [
        "A redelivered Pub/Sub message maps to the same run_id, and Airflow skips it",
        "A file generation that already loaded successfully is recorded as DUPLICATE_SKIPPED"
      ]
    },
    {
      "dot": "amber",
      "title": "Concurrency",
      "items": [
        "DFA_MAX_CONCURRENT_JOBS (default 1) because of the IN_USE_ADDRESSES quota",
        "Waiting files are scheduled Airflow task instances, so no lock objects are needed"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure outcome",
      "items": [
        "A FAILED status fails finalize, so the DAG run is red; REJECTED stays green",
        "If finalize never reported it, a DAG failure callback publishes a minimal event"
      ]
    }
  ]
