  "cards": [
    {
      "dot": "cyan",
      "title": "Exactly one job per generation",
      "items": [
        "The claim object makes duplicate Pub/Sub deliveries exit before any BigQuery write",
        "A file generation that already loaded successfully is recorded as DUPLICATE_SKIPPED"
      ]
    },
    {
      "dot": "amber",
      "title": "Concurrency",
      "items": [
        "DFA_MAX_CONCURRENT_JOBS slots (default 1) because of the IN_USE_ADDRESSES quota",
        "The lock is always released, even after a launch or poll error"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure outcome",
      "items": [
        "A FAILED status raises an error so the workflow execution itself fails",
        "A failed publish is logged and does not change the job outcome"
      ]
    }
  ]
