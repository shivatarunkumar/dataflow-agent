  "cards": [
    {
      "dot": "cyan",
      "title": "Who writes the status",
      "items": [
        "The workflow inserts IN_PROGRESS or DUPLICATE_SKIPPED",
        "The Dataflow MERGE sets SUCCESS, REJECTED or FAILED",
        "Finalize forces FAILED when the job did not end JOB_STATE_DONE",
        "FAILED also covers launch or poll errors and POLL_TIMEOUT"
      ]
    },
    {
      "dot": "rose",
      "title": "After a failure",
      "items": [
        "FAILED and REJECTED both publish one event to dfa-ingest-errors",
        "df-agent auto-retries only TRANSIENT_INFRA FAILED jobs, under 2 retries per 24 h",
        "A retry is a create-only copy invalid/ → landing/, so it gets a new generation"
      ]
    },
    {
      "dot": "slate",
      "title": "Not a state",
      "items": [
        "A duplicate Pub/Sub delivery hits an existing claim (HTTP 412) and exits without writing a row"
      ]
    }
  ]
