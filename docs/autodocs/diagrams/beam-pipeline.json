  "cards": [
    {
      "dot": "emerald",
      "title": "Whole-file decision",
      "items": [
        "Any failed ERROR check rejects the whole file: nothing loads and the status is REJECTED",
        "Reconciliation is SKIPPED when the file was rejected"
      ]
    },
    {
      "dot": "amber",
      "title": "Sequencing",
      "items": [
        "ReconcileCounts waits on every load and copy job before it counts rows",
        "job_metadata is written only with DML, so the workflow can still update the row"
      ]
    },
    {
      "dot": "slate",
      "title": "Contract side input",
      "items": [
        "FileMeta carries the matched contract to every step, so one pipeline serves customer, user and orders"
      ]
    }
  ]
