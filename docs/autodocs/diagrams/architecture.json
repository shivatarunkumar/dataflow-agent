  "cards": [
    {
      "dot": "cyan",
      "title": "Per-file orchestration",
      "items": [
        "pubsub_file_listener starts one gcs_to_bq_dataflow run per file generation",
        "The run_id comes from the generation, so a duplicate delivery is skipped",
        "Tasks: register_job, is_new_file, run_dataflow, finalize"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dataflow pipeline",
      "items": [
        "Contract match, file name, header, delimiter, trailer and data-type checks",
        "Loads only when every ERROR check passes, then reconciles row counts",
        "Every check goes to validation_metadata; the final status MERGE goes to job_metadata"
      ]
    },
    {
      "dot": "rose",
      "title": "Agent guard rails",
      "items": [
        "dfa-agent SA: read-only plus objectCreator on the landing bucket",
        "Reads Airflow runs and task logs with GET only, as an Airflow Viewer",
        "The policy engine decides; the LLM can only downgrade AUTO_APPROVED"
      ]
    },
    {
      "dot": "amber",
      "title": "Composer cost",
      "items": [
        "About $0.80-1.00 per hour while it exists, idle or not",
        "make airflow-up creates it; make airflow-down deletes only Composer",
        "Files landed while it is down wait on the subscription for 7 days"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "The GCP agent's read-only calls to Airflow, Dataflow, Logging, Compute quota and IAM",
        "Incident output in df-agent/actions/<incident_id>/: report.pdf, change.md, details/"
      ]
    }
  ]
