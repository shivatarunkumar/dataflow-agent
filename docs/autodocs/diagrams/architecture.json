  "cards": [
    { "dot": "cyan", "title": "Per-file orchestration", "items": [
      "Workflow steps: claim, register, acquire slot, launch, poll, release, finalize",
      "Claims and slot locks are create-only GCS objects (ifGenerationMatch=0)",
      "Failed or rejected jobs publish one self-contained event to dfa-ingest-errors"
    ] },
    { "dot": "emerald", "title": "Dataflow pipeline", "items": [
      "Contract match, file name, header, delimiter, trailer and data-type checks",
      "Loads only when every ERROR check passes, then reconciles row counts",
      "Every check goes to validation_metadata; the final status MERGE goes to job_metadata"
    ] },
    { "dot": "rose", "title": "Agent guard rails", "items": [
      "dfa-agent SA: read-only plus objectCreator on the landing bucket",
      "The policy engine decides; the LLM can only downgrade AUTO_APPROVED",
      "Auto-retry only TRANSIENT_INFRA FAILED jobs, under 2 retries per 24 h"
    ] },
    { "dot": "slate", "title": "Not drawn", "items": [
      "The GCP agent's read-only calls to Dataflow, Logging, Workflows, Compute quota and IAM",
